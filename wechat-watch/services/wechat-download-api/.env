# WeChat Download API 配置文件
# 首次使用：登录后凭证会自动填充到此文件

# 认证信息 (登录后自动填充，无需手动配置)
WECHAT_TOKEN=
WECHAT_COOKIE=
WECHAT_FAKEID=
WECHAT_NICKNAME=
WECHAT_EXPIRE_TIME=

# 限频配置 (单位: 次/分钟 或 秒)
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_PER_IP=5
RATE_LIMIT_ARTICLE_INTERVAL=3

# Webhook 通知 (留空则禁用)
WEBHOOK_URL=
WEBHOOK_NOTIFICATION_INTERVAL=300

# RSS 订阅配置
RSS_POLL_INTERVAL=3600
ARTICLES_PER_POLL=10
RSS_FETCH_FULL_CONTENT=true

# SOCKS5 代理池（可选，避免账号风控）
PROXY_URLS=

# 服务配置
SITE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false
